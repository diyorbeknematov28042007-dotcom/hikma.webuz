# Public canonical origin. Set this to your final Vercel URL or custom domain.
NEXT_PUBLIC_SITE_URL=
# Enable the form only after the delivery destination and privacy practice are approved.
CONTACT_FORM_ENABLED=false
# Telegram credentials stay on the server. Never add NEXT_PUBLIC_ to these keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Production spam protection: Cloudflare Turnstile site key + secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Public Telegram/Instagram links come from the owner's 2026-10-17 screenshot.
# They do not require credentials; form auto-delivery still requires the keys above.

# /advokat: use the lawyer's own verified profiles. Never point these at HIKMA.
NEXT_PUBLIC_LAW_TELEGRAM_URL=
NEXT_PUBLIC_LAW_INSTAGRAM_URL=
# Set all three location values together. Embed HTML comes from Google Maps > Share > Embed a map.
NEXT_PUBLIC_LAW_ADDRESS=
NEXT_PUBLIC_LAW_MAP_URL=
NEXT_PUBLIC_LAW_MAP_EMBED_URL=

# /interyer: use only the real interior studio's verified profiles.
NEXT_PUBLIC_INTERIOR_INSTAGRAM_URL=
NEXT_PUBLIC_INTERIOR_TELEGRAM_URL=
