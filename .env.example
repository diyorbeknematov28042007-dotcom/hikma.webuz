# Public canonical origin. Set this to your final Vercel URL or custom domain.
NEXT_PUBLIC_SITE_URL=
# Enable the form only after the delivery destination and privacy practice are approved.
CONTACT_FORM_ENABLED=false
# Telegram credentials stay on the server. Never add NEXT_PUBLIC_ to these keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Production spam protection: Cloudflare Turnstile site key + secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Verify the brand-owned Instagram link before enabling it.
INSTAGRAM_VERIFIED=false
